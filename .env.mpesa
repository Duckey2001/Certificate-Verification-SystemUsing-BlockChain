# Enhanced M-Pesa Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# M-Pesa B2B Configuration (Primary)
# ============================================
# Get these from your M-Pesa API portal
MPESA_API_KEY=your_complete_api_key_ending_with_5Gfn
MPESA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCqDiXc6iQmpBpI5B7pL7ZzK7B3
... (copy full public key from M-Pesa API documentation)
-----END PUBLIC KEY-----"

# Service Provider Configuration
SERVICE_PROVIDER_CODE=110799
ECOL_CODE=110799
COUNTRY=LES
CURRENCY=LSL

# API Configuration
SESSION_LIFETIME=3600
API_TIMEOUT=30

# ============================================
# Legacy M-Pesa Configuration (STK Push)
# ============================================
# For STK Push functionality (optional)
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_PASSKEY=your-mpesa-passkey
MPESA_SHORTCODE=your-mpesa-shortcode
MPESA_CALLBACK_URL=http://localhost:5000/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox  # sandbox or production

# ============================================
# SMS Gateway Configuration
# ============================================
# Choose SMS provider: 'africastalking', 'twilio', 'clickatell', or 'simulation'
SMS_PROVIDER=simulation

# Africa Talking Configuration
AFRICASTALKING_USERNAME=your-africastalking-username
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_SENDER_ID=ECOL

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Clickatell Configuration
CLICKATELL_API_KEY=your-clickatell-api-key

# ============================================
# Application Configuration
# ============================================
SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=sqlite:///./certivert.db

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Frontend URL
FRONTEND_BASE_URL=http://localhost:3000

# ============================================
# Blockchain Configuration
# ============================================
# Certificate Registry Address (auto-loaded from blockchain/registry.json)
CERT_REGISTRY_ADDRESS=
ISSUER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
HARDHAT_RPC_URL=http://127.0.0.1:8545

# ============================================
# OCR Configuration
# ============================================
OCR_SPACE_API_KEY=your-ocr-space-api-key
OCR_SPACE_API_URL=https://api.ocr.space/parse/image

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
GEMINI_ENABLED=true

# Multi-OCR Configuration
OCR_PREFERRED_API=auto
OCR_FALLBACK_ENABLED=true
OCR_CONFIDENCE_THRESHOLD=70

# ============================================
# Debug and Development
# ============================================
# Set to 'false' in production
FLASK_DEBUG=true
FLASK_ENV=development

# Logging
LOG_LEVEL=INFO

# ============================================
# Production Settings (uncomment for production)
# ============================================
# FLASK_DEBUG=false
# FLASK_ENV=production
# CORS_ORIGINS=https://yourdomain.com
# MPESA_ENVIRONMENT=production
# SMS_PROVIDER=africastalking  # Use real SMS provider
