# Backend config (development)
PORT=8000

# JWT
SECRET_KEY=certivert-dev-secret
DATABASE_URL=postgresql://diploma_admin:diploma1234@localhost:5432/diploma_verification

# Additional postgres environment variables for tooling
POSTGRES_USER=diploma_admin
POSTGRES_PASSWORD=diploma1234
POSTGRES_DB=diploma_verification
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection pool settings (can be consumed by libraries that read them)
PG_MAX_CONNECTIONS=10
PG_IDLE_TIMEOUT=10000
PG_CONNECTION_TIMEOUT=0

# Hardhat / EVM registry (development)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CERTIFICATE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Default Hardhat account #0 private key (dev only)
ISSUER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CORS_ORIGINS="http://localhost:3000"

# Google OAuth (required for institution login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
