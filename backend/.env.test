# M-Pesa Lesotho Configuration (Vodacom Lesotho - Production Ready)
MPESA_LESOTHO_CONSUMER_KEY=your_real_consumer_key_here
MPESA_LESOTHO_CONSUMER_SECRET=your_real_consumer_secret_here
MPESA_LESOTHO_PASSKEY=your_real_passkey_here
MPESA_LESOTHO_SHORTCODE=your_real_shortcode_here
MPESA_CALLBACK_URL=http://localhost:8000/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox

# M-Pesa B2B Configuration for Lesotho
MPESA_API_KEY=your_api_key_here_ends_with_5Gfn
MPESA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC6Dc9E8fK4nB2M9v7L6qX3Z8rA1
YOUR_ACTUAL_PUBLIC_KEY_HERE_REPLACE_WITH_M-PESA_PROVIDED_KEY
-----END PUBLIC KEY-----"

# Service Provider Codes (8-digit merchant numbers)
SERVICE_PROVIDER_CODE=00110799
ECOL_CODE=00110799  # ECOL's receiving code

# Country Settings
COUNTRY=LES
CURRENCY=LSL

# Session Configuration
SESSION_LIFETIME=3600
API_TIMEOUT=30

# M-Pesa B2B Enhanced Configuration
MPESA_MINIMUM_AMOUNT=500
MPESA_MAXIMUM_AMOUNT=1000000
MPESA_WEBHOOK_SECRET=your_webhook_secret_here
MPESA_DEBUG=false

# Backend Configuration
SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OCR.space API Configuration
OCR_SPACE_API_KEY=your_ocr_space_api_key_here
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_ENABLED=true

# Google Cloud Vision API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
# First 1000 units/month are free
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# Generative AI with vision capabilities for OCR
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
GEMINI_ENABLED=true

# Kolosal AI OCR Configuration
# No API key required - 100% free service
KOLOSAL_API_URL=https://api.kolosal.ai/ocr

# Multi-OCR Configuration
OCR_PREFERRED_API=auto
OCR_FALLBACK_ENABLED=true
OCR_CONFIDENCE_THRESHOLD=70
