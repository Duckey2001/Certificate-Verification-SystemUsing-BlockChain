# M-Pesa Lesotho Configuration (REAL PRODUCTION CREDENTIALS)
# Get these from: https://developer.safaricom.co.ke/ (for Lesotho Vodacom)

MPESA_CONSUMER_KEY=your_real_consumer_key_here
MPESA_CONSUMER_SECRET=your_real_consumer_secret_here  
MPESA_PASSKEY=your_real_passkey_here
MPESA_SHORTCODE=your_real_shortcode_here
MPESA_CALLBACK_URL=http://localhost:8000/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox  # Change to production for live transactions

# For testing with your personal number:
TEST_PHONE_NUMBER=+2665XXXXXXXXX  # Your real M-Pesa number
TEST_AMOUNT=1.00  # Small amount for testing

# Database
DATABASE_URL=postgresql://diploma_admin:diploma1234@localhost:5432/diploma_verification
SECRET_KEY=certivert-payment-test-secret-key

# OCR Configuration (already working)
OCR_SPACE_API_KEY=your_ocr_space_api_key_here
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
