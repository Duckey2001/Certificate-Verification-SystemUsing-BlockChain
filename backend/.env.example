# Backend Environment Variables

# Secret key for JWT tokens
SECRET_KEY=your-secret-key-change-in-production

# Database URL (SQLite for development)
DATABASE_URL=sqlite:///./certivert.db

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# M-Pesa B2B Configuration
# Get these from your M-Pesa API portal
MPESA_API_KEY=your_complete_api_key_ending_with_5Gfn
MPESA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCqDiXc6iQmpBpI5B7pL7ZzK7B3
... (copy full public key from API docs)
-----END PUBLIC KEY-----"
SERVICE_PROVIDER_CODE=110799
ECOL_CODE=110799
COUNTRY=LES
CURRENCY=LSL
SESSION_LIFETIME=3600
API_TIMEOUT=30

# Legacy M-Pesa Configuration (for reference)
# MPESA_CONSUMER_KEY=your-mpesa-consumer-key
# MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
# MPESA_PASSKEY=your-mpesa-passkey
# MPESA_SHORTCODE=your-mpesa-shortcode
# MPESA_CALLBACK_URL=http://localhost:8000/api/mpesa/callback
# MPESA_ENVIRONMENT=sandbox  # sandbox or production

# Blockchain (CertificateRegistry) - required for real on-chain certificate issuance
# After deploying: cd blockchain && npm run deploy (writes registry.json)
# Address is auto-loaded from backend/blockchain/registry.json if not set
# CERT_REGISTRY_ADDRESS=0x...
# Hardhat account #0 private key (local dev only - NEVER use in production)
ISSUER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# HARDHAT_RPC_URL=http://127.0.0.1:8545

# CORS - comma-separated origins or * for dev
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Frontend URL (for invitation links)
# FRONTEND_BASE_URL=http://localhost:3000

# OCR.space API Configuration
# Free OCR API for enhanced certificate text extraction
OCR_SPACE_API_KEY=your-ocr-space-api-key
OCR_SPACE_API_URL=https://api.ocr.space/parse/image

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# Generative AI with vision capabilities for advanced OCR
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
GEMINI_ENABLED=true

# Multi-OCR Configuration
OCR_PREFERRED_API=auto
OCR_FALLBACK_ENABLED=true
OCR_CONFIDENCE_THRESHOLD=70
