# Backend Environment Variables

# Secret key for JWT tokens
SECRET_KEY=your-secret-key-change-in-production

# Database URL (SQLite for development)
DATABASE_URL=sqlite:///./certivert.db

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# M-Pesa Configuration
# Get these from: https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_PASSKEY=your-mpesa-passkey
MPESA_SHORTCODE=your-mpesa-shortcode
MPESA_CALLBACK_URL=http://localhost:8000/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox  # sandbox or production

# Blockchain (CertificateRegistry) - required for real on-chain certificate issuance
# After deploying: cd blockchain && npm run deploy (writes registry.json)
# Address is auto-loaded from backend/blockchain/registry.json if not set
# CERT_REGISTRY_ADDRESS=0x...
# Hardhat account #0 private key (local dev only - NEVER use in production)
ISSUER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# HARDHAT_RPC_URL=http://127.0.0.1:8545

# CORS - comma-separated origins or * for dev
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Frontend URL (for invitation links)
# FRONTEND_BASE_URL=http://localhost:3000
